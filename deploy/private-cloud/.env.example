# 이 예시를 .env로 복사하고 chmod 600으로 보호한다. Git에 .env를 올리지 않는다.
# shell source/eval하지 않는 단순 KEY=value 형식이다. 따옴표·변수 치환 없이 작성한다.
# 아래 값은 설치 승인 뒤 현장 읽기 전용 점검 결과와 대조한다.
NEXUS_SSD_MOUNT=/mnt/ssd
NEXUS_SSD_UUID=CHANGE_ME
NEXUS_SSD_LABEL=BMO_SSD
# 최소 가용 공간 1 GiB. SSD 장기 안정성/백업 확인 전에는 테스트 파일만 사용한다.
NEXUS_MIN_FREE_BYTES=1073741824
# BMO 수동 실행 사용자의 UID. 종료 확인과 전체 프로세스 검사가 모두 필요하다.
BMO_SCAN_UID=1000
